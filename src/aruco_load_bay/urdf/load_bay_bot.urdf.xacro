<?xml version="1.0"?>
<robot name="roomba" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 🔗 INCLUDE EXTERNAL SENSOR XACRO FILES -->
    <xacro:include filename="$(find aruco_load_bay)/urdf/lidar.xacro"/>
    <xacro:include filename="$(find aruco_load_bay)/urdf/camera.xacro"/>

    <!-- ================= 1. PROPERTIES ================= -->
    <xacro:property name="chassis_radius" value="0.25"/>
    <xacro:property name="chassis_length" value="0.15"/>
    <xacro:property name="chassis_mass"   value="2.0"/>

    <xacro:property name="wheel_radius"   value="0.09"/>
    <xacro:property name="wheel_width"    value="0.044"/>
    <xacro:property name="wheel_mass"     value="0.2"/>
    <xacro:property name="wheel_y_offset" value="0.21"/>

    <xacro:property name="caster_radius"  value="0.03"/>
    <xacro:property name="caster_mass"    value="0.05"/>
    <xacro:property name="caster_x_offset" value="0.19"/>

    <!-- ================= 2. MATERIALS ================= -->
    <material name="violet"><color rgba="0.876 0 0.476 1"/></material>
    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="ash"><color rgba="0.1 0.1 0.1 1"/></material>
    <material name="red"><color rgba="1 0 0 1"/></material>

    <!-- ================= 3. BASE FOOTPRINT & BASE LINK ================= -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${chassis_radius}" length="${chassis_length}"/>
            </geometry>
            <material name="violet"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${chassis_radius}" length="${chassis_length}"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <mass value="${chassis_mass}"/>
            <inertia ixx="0.035" ixy="0.0" ixz="0.0" iyy="0.035" iyz="0.0" izz="0.0625"/>
        </inertial>
    </link>

    <!-- ================= 4. DRIVE WHEEL MACRO ================= -->
    <xacro:macro name="drive_wheel" params="prefix y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <mass value="${wheel_mass}"/>
                <inertia ixx="0.000437" ixy="0.0" ixz="0.0" iyy="0.000437" iyz="0.0" izz="0.00081"/>
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <!-- Perfectly places wheel center so bottom rests on ground level -->
            <origin xyz="0 ${y_reflect * wheel_y_offset} ${wheel_radius}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <!-- Instantiate Left and Right Drive Wheels -->
    <xacro:drive_wheel prefix="left"  y_reflect="1"/>
    <xacro:drive_wheel prefix="right" y_reflect="-1"/>

    <!-- ================= 5. CASTER BALL MACRO ================= -->
    <xacro:macro name="caster_ball" params="prefix x_reflect joint_name">
        <link name="${prefix}_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
                <material name="ash"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${caster_mass}"/>
                <inertia ixx="0.000018" ixy="0" ixz="0" iyy="0.000018" iyz="0" izz="0.000018"/>
            </inertial>
        </link>

        <joint name="${joint_name}" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_link"/>
            <origin xyz="${x_reflect * caster_x_offset} 0 ${caster_radius}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <!-- Instantiate Front and Rear Casters -->
    <xacro:caster_ball prefix="ball"  x_reflect="1"  joint_name="cen_joint"/>
    <xacro:caster_ball prefix="ball2" x_reflect="-1" joint_name="b_joint"/>

    <!-- ================= 6. GAZEBO PLUGINS ================= -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${wheel_y_offset * 2}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            
            <topic>/model/vacuum_bot/cmd_vel</topic>
            <odom_topic>/model/vacuum_bot/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>
        
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
            <topic>/joint_states</topic>
        </plugin>
    </gazebo>

</robot>
